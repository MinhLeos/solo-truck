NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Only needed in production (Vercel auto-populates NEXT_PUBLIC_VERCEL_URL for
# Preview deployments — see src/lib/get-app-url.ts).
NEXT_PUBLIC_APP_URL=

# Bearer secret Vercel Cron sends automatically once this is set — see
# src/app/api/cron/reminders/route.ts.
CRON_SECRET=

# Reminder emails (src/lib/notifications/send-email.ts) fall back to
# console.log in dev when this is unset.
RESEND_API_KEY=

# MoR billing (Dodo Payments — src/lib/billing/). "test_mode" or "live_mode",
# required explicitly so a missing env var can never silently charge live.
BILLING_ENVIRONMENT=
BILLING_PROVIDER_API_KEY=
BILLING_WEBHOOK_SECRET=
BILLING_PRODUCT_ID_MONTHLY=
BILLING_PRODUCT_ID_YEARLY=

# Sentry (error monitoring — dashboard.sentry.io, free tier is enough for MVP)
NEXT_PUBLIC_SENTRY_DSN=https://a7ee5f662d6bace4e9fb5561c8a72181@o4511846241599488.ingest.us.sentry.io/4511889785618432
# Only needed for source map upload during `next build` — leave blank to skip.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
